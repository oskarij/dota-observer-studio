{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "build/electron",
    "rootDir": "src",
    "types": ["node", "electron"]
  },
  "include": [
    "src/electron/**/*.ts",
    "src/electron/**/*.cts",
    "src/persistence/**/*.ts",
    "src/runtime/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
