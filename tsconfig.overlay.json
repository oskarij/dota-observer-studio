{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "build/overlay-assets",
    "rootDir": "src",
    "types": ["vite/client"]
  },
  "include": ["src/overlay/**/*.ts", "src/shared/**/*.ts"]
}
