{
  "name": "dota-spectator-tools-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build/electron/electron/main.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:overlay && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:overlay": "vite build --config vite.overlay.config.ts",
    "build:web": "vite build",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:overlay && npm run build:electron && electron .",
    "dev:web": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.test.json && node --test build/test/tests/gsiSelection.test.js build/test/tests/playerProfiles.test.js",
    "typecheck": "svelte-kit sync && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.overlay.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-store": "^10.1.0"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.31",
    "concurrently": "^9.1.2",
    "electron": "^42.3.3",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-svelte": "^3.9.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.56.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^8.0.16",
    "wait-on": "^8.0.3"
  }
}
